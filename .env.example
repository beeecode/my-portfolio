# ── Backend (server.js) ──────────────────────────────────────────────────
# The production URL of your portfolio (used for CORS origin)
APP_URL=https://your-production-domain.vercel.app

# Gmail address that will send/receive contact form messages
EMAIL_USER=

# Gmail App Password (NOT your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on your Google account
EMAIL_PASS=
