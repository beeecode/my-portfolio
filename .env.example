# ── Backend (server.js) ──────────────────────────────────────────────────
# The production URL of your portfolio (used for CORS origin)
APP_URL=https://your-production-domain.vercel.app

# Gmail address that will send/receive contact form messages
EMAIL_USER=

# Gmail App Password (NOT your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on your Google account
EMAIL_PASS=

# Manageull public runtime installation (defaults match this portfolio)
MANAGEULL_API_ORIGIN=https://manageull-backend.onrender.com
MANAGEULL_SITE_KEY=mng_site_47srnWgOTiqkyi3Vkir_RGjiwrbgtQKmqLWVBFDJTjw
MANAGEULL_SITE_VERIFICATION=mng_verify_SyiecGH5QQCc0061Cve-OLplC1NySuUOmGMPc2n8Rrg

# Required only for instant publish/rollback cache invalidation.
# Copy the site's ID from Manageull and use the SAME signing secret in Publish Settings.
# Never prefix this secret with NEXT_PUBLIC_.
MANAGEULL_SITE_ID=
MANAGEULL_WEBHOOK_SECRET=
