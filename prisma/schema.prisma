generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id               String   @id @default("portfolio")
  name             String
  role             String
  heroDescription  String   @db.Text
  aboutHeading     String
  aboutAccent      String
  aboutEyebrow     String
  aboutParagraphOne String  @db.Text
  aboutParagraphTwo String  @db.Text
  profileImage     String
  email            String
  linkedInUrl      String
  githubUrl        String
  contactHeading   String
  contactText      String   @db.Text
  updatedAt        DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  image       String
  tags        String[]
  url         String
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SkillGroup {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("code")
  sortOrder Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id           String     @id @default(cuid())
  name         String
  iconClass    String
  sortOrder    Int        @default(0)
  skillGroupId String
  skillGroup   SkillGroup @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
}

model Experience {
  id        String   @id @default(cuid())
  role      String
  company   String
  period    String
  location  String
  points    String[]
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
